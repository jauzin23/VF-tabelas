# ================================================================
# VF-Tabelas — Configuração
# Copiar para .env e editar os valores conforme necessário.
# ================================================================

# ----------------------------------------------------------------
# BACKEND
# ----------------------------------------------------------------

# Porta do servidor backend
BACKEND_PORT=4000

# CORS: domínio(s) do backoffice separados por vírgula.
# Use * para desenvolvimento ou acesso sem restrições.
# Exemplo produção: ALLOWED_ORIGINS=https://meudominio.com,https://www.meudominio.com
ALLOWED_ORIGINS=*

# Rastreador web — limites de navegação
MAX_PAGES=50
MAX_DEPTH=3
PAGE_TIMEOUT_MS=30000

# Concorrência do rastreador (0 = automático baseado em CPU)
CRAWLER_CONCURRENCY=0

# Tempo limite global por tarefa, em segundos
JOB_TIMEOUT_S=600

# Filtro de imagens — dimensões mínimas em pixels
MIN_IMAGE_WIDTH=120
MIN_IMAGE_HEIGHT=80
MIN_IMAGE_AREA=9600

# Deteção de tabelas por IA
TABLE_MIN_CONFIDENCE=0.5
ANALYSIS_CONCURRENCY=2
IMAGE_HTTP_RETRIES=2

# Estrutura mínima para validar uma tabela
STRUCTURE_MIN_ROWS=2
STRUCTURE_MIN_COLS=2

# ----------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------

# Porta do frontend
FRONTEND_PORT=3000

# URL da API do backend — vista pelo browser do utilizador final.
# Em Docker local: http://localhost:4000
# Em produção: colocar o URL público do backend (ex: https://api.meudominio.com)
NEXT_PUBLIC_API_URL=http://localhost:4000
